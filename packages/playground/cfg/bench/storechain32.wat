(module (memory 1)
  (func (export "run") (param $n i32) (result i32)
    (local $i i32) (local $b i32) (local $acc i32)
    (loop $top
      (local.set $b (i32.add (i32.const 4096) (i32.shl (local.get $i) (i32.const 9))))
      (i32.store offset=0 (local.get $b) (i32.const 1000))
      (i32.store offset=4 (local.get $b) (i32.const 1001))
      (i32.store offset=8 (local.get $b) (i32.const 1002))
      (i32.store offset=12 (local.get $b) (i32.const 1003))
      (i32.store offset=16 (local.get $b) (i32.const 1004))
      (i32.store offset=20 (local.get $b) (i32.const 1005))
      (i32.store offset=24 (local.get $b) (i32.const 1006))
      (i32.store offset=28 (local.get $b) (i32.const 1007))
      (i32.store offset=32 (local.get $b) (i32.const 1008))
      (i32.store offset=36 (local.get $b) (i32.const 1009))
      (i32.store offset=40 (local.get $b) (i32.const 1010))
      (i32.store offset=44 (local.get $b) (i32.const 1011))
      (i32.store offset=48 (local.get $b) (i32.const 1012))
      (i32.store offset=52 (local.get $b) (i32.const 1013))
      (i32.store offset=56 (local.get $b) (i32.const 1014))
      (i32.store offset=60 (local.get $b) (i32.const 1015))
      (i32.store offset=64 (local.get $b) (i32.const 1016))
      (i32.store offset=68 (local.get $b) (i32.const 1017))
      (i32.store offset=72 (local.get $b) (i32.const 1018))
      (i32.store offset=76 (local.get $b) (i32.const 1019))
      (i32.store offset=80 (local.get $b) (i32.const 1020))
      (i32.store offset=84 (local.get $b) (i32.const 1021))
      (i32.store offset=88 (local.get $b) (i32.const 1022))
      (i32.store offset=92 (local.get $b) (i32.const 1023))
      (i32.store offset=96 (local.get $b) (i32.const 1024))
      (i32.store offset=100 (local.get $b) (i32.const 1025))
      (i32.store offset=104 (local.get $b) (i32.const 1026))
      (i32.store offset=108 (local.get $b) (i32.const 1027))
      (i32.store offset=112 (local.get $b) (i32.const 1028))
      (i32.store offset=116 (local.get $b) (i32.const 1029))
      (i32.store offset=120 (local.get $b) (i32.const 1030))
      (i32.store offset=124 (local.get $b) (i32.const 1031))
      (local.set $acc (i32.load offset=0 (local.get $b)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $top (i32.lt_s (local.get $i) (local.get $n))))
    (local.get $acc)))
