+// condFlowTerminal reports whether the upward walk in getConditionalFlowTypeOfType stops at this node.
+func condFlowTerminal(node *ast.Node) bool {
+	return node == nil || ast.IsStatement(node) || node.Kind == ast.KindJSDoc
+}
+
+// condFlowRelevant reports whether the loop body of getConditionalFlowTypeOfType can do anything
+// other than `node = parent` when visiting this node (independent of the type being filtered).
+func condFlowRelevant(node *ast.Node) bool {
+	parent := node.Parent
+	if parent == nil {
+		return false
+	}
+	if ast.IsParameterDeclaration(parent) {
+		return true
+	}
+	if ast.IsConditionalTypeNode(parent) && node == parent.AsConditionalTypeNode().TrueType {
+		return true
+	}
+	if ast.IsMappedTypeNode(parent) && parent.AsMappedTypeNode().NameType == nil && node == parent.Type() {
+		return true
+	}
+	return false
+}
